; Finna specific datasource settings
;[marc]
;Which fields to index as a linking id for record as colon separated list.
; 001,0:035a,1
; 001 = field to get value from
; 1 = prepend prefix from 003, 0 no, 1 yes
; 035a = get ids from fields subfields a
;driverParams[] = "recordLinkingIdFields=\"001,1:035a,0:999c,0\""

; RecordManager settings for Finna module
[MediaType]
; The following setting can be used to exclude file extensions taken from
; pathinfo when checking for the media type
;excluded_file_extensions[] = "mp3"
;excluded_file_extensions[] = "css"
;excluded_file_extensions[] = "sib"

; Lido only settings
[LidoRecord]
; The following section excludes certain location places
; Compares to: ...namePlaceSet->appellationValue->attributes()->label
;excluded_location_labels[] = "Torin nurkkaus etäällä"

[MarcRecord]
; A colon-separated list of MARC fields to index as a linking ids for record.
; Format:
; field,prepend:field,prepent
; field = field code, and subfield code for variable fields
; prepend = whether to prepend 003 to the field. 0 = no (default), 1 = yes.
; Example:
;record_linking_id_fields = "001,1:035a,0:999c,0"
